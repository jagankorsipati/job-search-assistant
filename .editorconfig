root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,json,yml,yaml}]
indent_size = 2

[*.{sql,ps1}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off
